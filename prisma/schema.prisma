// Order Processing System
// Clients submit orders, admin assigns them, team processes them, admin collects payment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  TEAM
}

enum OrderStatus {
  NEW
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_DUE // work not completed yet
  PENDING // completed, waiting for payment
  PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  // CLIENT only: fixed charge per order, and unapplied money received.
  ratePerOrder Decimal? @db.Decimal(12, 2)
  creditBalance Decimal @default(0) @db.Decimal(12, 2)
  // CLIENT only: when true, the client can see the processing price on their orders.
  showPurchasePrice Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientOrders    Order[]   @relation("OrderClient")
  assignedOrders  Order[]   @relation("OrderAssignee")
  createdOrders   Order[]   @relation("OrderCreator")
  processedOrders Order[]   @relation("OrderProcessor")
  completedOrders Order[]   @relation("OrderCompleter")
  clientPayments  Payment[] @relation("PaymentClient")
  recordedPayments Payment[] @relation("PaymentRecorder")
  orderEvents     OrderEvent[]
  auditLogs       AuditLog[]

  @@index([role, active])
}

model Order {
  id          String @id @default(cuid())
  // Unique per client, so two clients can use the same marketplace order ID.
  orderNumber String

  clientId     String
  client       User    @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  assignedToId String?
  assignedTo   User?   @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User    @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(NOT_DUE)

  clientReference String?

  // Customer block exactly as pasted. customerName is its first line, for lists and search.
  customerName    String
  customerDetails String @db.Text

  // Product
  productUrl  String @db.Text
  variantName String

  // AES-256-GCM ciphertext. Permanently cleared when the order is processed or cancelled.
  cardInfoEnc String? @db.Text

  // Rate locked when the order is created. Hidden from TEAM.
  rate Decimal @db.Decimal(12, 2)

  // Processing. accountName is visible to CLIENT; purchasePrice is ADMIN only.
  accountName   String?
  purchasePrice Decimal?  @db.Decimal(12, 2)
  processedById String?
  processedBy   User?     @relation("OrderProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?

  // Tracking / completion
  trackingNumber String?
  carrier        String?
  completedById  String?
  completedBy    User?     @relation("OrderCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt    DateTime?

  // Payment / archive
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paidAt     DateTime?
  archived   Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]

  @@unique([clientId, orderNumber])
  @@index([clientId, archived, status])
  @@index([assignedToId, archived, status])
  @@index([clientId, paymentStatus, completedAt])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  clientId     String
  client       User     @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Restrict)
  recordedById String
  recordedBy   User     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(12, 2)
  // Amount of this payment + prior credit that settled orders, and what is left as credit.
  appliedAmount Decimal @db.Decimal(12, 2)
  creditAfter  Decimal  @db.Decimal(12, 2)
  mode         String // "AUTO" | "SELECTED"
  note         String?
  receivedAt   DateTime @default(now())

  orders Order[]

  @@index([clientId, receivedAt])
}

// Timeline. `visibility` keeps team/admin-only details away from clients.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       String
  message    String   @db.Text
  clientVisible Boolean @default(true)
  teamVisible   Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

# PostgreSQL connection string. Use a new, empty database.
DATABASE_URL="postgresql://order_user:change-me@localhost:5432/order_system?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-please-32-chars-min-random"
NEXTAUTH_URL="http://localhost:3000"

# Encrypts card info. Must decode to 32 bytes. Generate with: openssl rand -base64 32
# Keep it out of Git and backups of the code. Changing it makes unprocessed card info unreadable.
ENCRYPTION_KEY=""

# Login password for local demo users, created by: npm run db:seed:demo
DEMO_PASSWORD=""

# First admin, created by: npm run db:seed
# Leave SEED_PASSWORD empty to generate one and print it once.
SEED_EMAIL="admin@example.com"
SEED_PASSWORD=""
